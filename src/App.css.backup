/* =========================================================
   GLOBAL RESET
========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background: #050816;
  color: #f8fafc;
  overflow-x: hidden;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: none;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

/* =========================================================
   NAVBAR
========================================================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(5, 8, 22, 0.72);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.nav-container {
  width: min(1180px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.nav-logo {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: #ffffff;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 26px;
}

.nav-link {
  position: relative;
  color: #94a3b8;
  font-size: 0.84rem;
  font-weight: 500;
  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -7px;
  width: 0;
  height: 1px;
  background: #67e8f9;
  transition: width 0.25s ease;
}

.nav-link:hover {
  color: #ffffff;
  transform: translateY(-1px);
}

.nav-link:hover::after {
  width: 100%;
}

.hire-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 100px;
  padding: 10px 18px;

  border: 1px solid rgba(103, 232, 249, 0.35);
  border-radius: 999px;

  color: #e0f2fe;
  background: rgba(103, 232, 249, 0.07);

  font-size: 0.82rem;
  font-weight: 700;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}

.hire-btn:hover {
  transform: translateY(-2px);
  background: rgba(103, 232, 249, 0.13);
  border-color: rgba(103, 232, 249, 0.7);
}

/* =========================================================
   SHARED SECTION
========================================================= */

.section-heading {
  max-width: 720px;
  margin: 0 auto 55px;
  text-align: center;
}

.section-tag {
  display: inline-block;
  margin-bottom: 15px;

  color: #67e8f9;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.2em;
}

.section-heading h2 {
  margin-bottom: 18px;

  color: #f8fafc;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.04em;
}

.section-heading h2 span {
  color: #67e8f9;
}

.section-heading p {
  max-width: 650px;
  margin: 0 auto;

  color: #94a3b8;
  font-size: 0.98rem;
  line-height: 1.8;
}

/* =========================================================
   HERO
========================================================= */

.hero-section {
  position: relative;
  min-height: 100vh;
  padding: 140px 0 90px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 45%,
      rgba(34, 211, 238, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 18% 30%,
      rgba(59, 130, 246, 0.06),
      transparent 28%
    ),
    #050816;
}

.hero-container {
  position: relative;
  z-index: 2;

  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 70px;
}

.hero-content {
  max-width: 650px;
}

.availability-badge {
  width: fit-content;

  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 20px;
  padding: 8px 13px;

  border: 1px solid rgba(74, 222, 128, 0.2);
  border-radius: 999px;

  background: rgba(74, 222, 128, 0.05);

  color: #bbf7d0;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.availability-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 12px rgba(74, 222, 128, 0.8);
}

.hero-name {
  margin-bottom: 18px;

  font-size: clamp(2.8rem, 5vw, 4.2rem);
  line-height: 1;
  letter-spacing: -0.055em;
  font-weight: 900;

  background: linear-gradient(
    100deg,
    #ffffff 0%,
    #c4b5fd 35%,
    #67e8f9 70%,
    #ffffff 100%
  );

  background-size: 220% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;

  animation: heroNameGradient 5s linear infinite;
}

@keyframes heroNameGradient {
  0% {
    background-position: 0% center;
  }

  50% {
    background-position: 100% center;
  }

  100% {
    background-position: 0% center;
  }
}

.name-cursor {
  margin-left: 4px;

  color: #67e8f9;
  -webkit-text-fill-color: #67e8f9;

  animation: cursorBlink 0.9s infinite;
}

@keyframes cursorBlink {
  0%,
  45% {
    opacity: 1;
  }

  46%,
  100% {
    opacity: 0;
  }
}

/* =========================================================
   CODE ROLE
========================================================= */

.code-role {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  margin-bottom: 22px;

  font-family:
    "JetBrains Mono",
    "Fira Code",
    Consolas,
    monospace;

  font-size: clamp(0.95rem, 2vw, 1.15rem);
}

.code-keyword {
  color: #c084fc;
}

.code-variable {
  color: #67e8f9;
}

.code-symbol {
  color: #94a3b8;
}

.code-string {
  min-width: 160px;
  transition: color 0.3s ease;
}

.role-ai {
  color: #67e8f9;
}

.role-problem {
  color: #c4b5fd;
}

.role-backend {
  color: #93c5fd;
}

.code-cursor {
  color: #67e8f9;
  animation: cursorBlink 0.8s infinite;
}

/* =========================================================
   HERO DESCRIPTION
========================================================= */

.hero-description {
  max-width: 600px;
  margin-bottom: 30px;

  color: #94a3b8;
  font-size: 1rem;
  line-height: 1.85;
}

/* =========================================================
   HERO BUTTONS
========================================================= */

.hero-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 13px;
  margin-bottom: 25px;
}

.hero-btn {
  min-height: 48px;
  padding: 0 19px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  border-radius: 10px;

  font-size: 0.86rem;
  font-weight: 700;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.primary-btn {
  color: #04111a;
  background: #67e8f9;
}

.primary-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(103, 232, 249, 0.18);
}

.secondary-btn {
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: rgba(255, 255, 255, 0.025);
}

.secondary-btn:hover {
  transform: translateY(-3px);
  border-color: rgba(103, 232, 249, 0.45);
  background: rgba(103, 232, 249, 0.05);
}

/* =========================================================
   HERO SOCIALS
========================================================= */

.hero-socials {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 35px;
}

.hero-socials a {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 10px;

  color: #94a3b8;
  background: rgba(255, 255, 255, 0.025);

  transition:
    transform 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.hero-socials a:hover {
  transform: translateY(-3px);
  color: #67e8f9;
  border-color: rgba(103, 232, 249, 0.4);
  background: rgba(103, 232, 249, 0.06);
}

/* =========================================================
   HERO STATS
========================================================= */

.hero-stats {
  display: flex;
  align-items: center;
  gap: 30px;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.hero-stat strong {
  color: #f8fafc;
  font-size: 1.1rem;
  font-weight: 800;
}

.hero-stat span {
  color: #64748b;
  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

/* =========================================================
   HERO VISUAL
========================================================= */

.hero-visual {
  position: relative;

  min-height: 520px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-glow {
  position: absolute;

  width: 300px;
  height: 380px;

  border-radius: 40%;

  background: rgba(34, 211, 238, 0.13);
  filter: blur(80px);
}

.photo-card {
  position: relative;
  z-index: 3;

  width: 285px;
  height: 380px;

  overflow: hidden;

  border: 1px solid rgba(103, 232, 249, 0.18);
  border-radius: 26px;

  background: #0b1124;

  cursor: pointer;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.42),
    0 0 50px rgba(34, 211, 238, 0.07);

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.photo-card:hover,
.photo-card.photo-active {
  border-color: rgba(103, 232, 249, 0.42);

  box-shadow:
    0 35px 90px rgba(0, 0, 0, 0.5),
    0 0 70px rgba(34, 211, 238, 0.12);
}

.photo-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(5, 8, 22, 0.82),
      transparent 42%
    );
}

.photo-touch {
  position: absolute;
  bottom: 17px;
  left: 0;
  right: 0;

  text-align: center;

  color: rgba(226, 232, 240, 0.72);
  font-size: 0.67rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* =========================================================
   FLOATING CARDS
========================================================= */

.floating-card {
  position: absolute;
  z-index: 5;

  min-width: 150px;
  padding: 14px 16px;

  border: 1px solid rgba(103, 232, 249, 0.14);
  border-radius: 13px;

  background: rgba(10, 17, 35, 0.78);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);

  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
}

.floating-label {
  display: block;
  margin-bottom: 6px;

  color: #67e8f9;
  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.floating-card strong {
  display: block;

  color: #f8fafc;
  font-size: 0.82rem;
}

.floating-card small {
  color: #64748b;
  font-size: 0.68rem;
}

.degree-card {
  top: 65px;
  left: 0;
}

.specialization-card {
  right: 0;
  bottom: 95px;
}

.experience-card {
  left: 20px;
  bottom: 35px;
}

.mini-profile-card {
  position: absolute;
  right: 15px;
  top: 45px;
  z-index: 5;

  min-width: 92px;
  padding: 11px 13px;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;

  border: 1px solid rgba(192, 132, 252, 0.18);
  border-radius: 13px;

  background: rgba(10, 17, 35, 0.76);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}

.mini-profile-card span {
  color: #c4b5fd;
  font-size: 1.05rem;
  font-weight: 900;
}

.mini-profile-card small {
  color: #64748b;
  font-size: 0.6rem;
  font-weight: 700;
}

/* =========================================================
   HERO BACKGROUND
========================================================= */

.hero-bg-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(70px);
}

.hero-bg-glow-one {
  width: 250px;
  height: 250px;
  top: 10%;
  left: -100px;
  background: rgba(59, 130, 246, 0.07);
}

.hero-bg-glow-two {
  width: 300px;
  height: 300px;
  right: -120px;
  bottom: 5%;
  background: rgba(34, 211, 238, 0.06);
}

.hero-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-particle {
  position: absolute;

  border-radius: 50%;

  background: #67e8f9;

  box-shadow: 0 0 8px rgba(103, 232, 249, 0.6);
}

/* =========================================================
   ABOUT
========================================================= */

.about-section {
  position: relative;

  padding: 110px 0;

  background: #060a18;
}

.about-container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.about-content {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.about-content p {
  margin-bottom: 18px;

  color: #94a3b8;
  font-size: 1rem;
  line-height: 1.9;
}

.about-content strong {
  color: #e2e8f0;
}

/* =========================================================
   AI DEVELOPER COMMAND CENTER
========================================================= */

.command-center-section {
  position: relative;

  padding: 120px 0;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(34, 211, 238, 0.055),
      transparent 34%
    ),
    #050816;
}

.command-center-section::before {
  content: "";

  position: absolute;
  top: 0;
  left: 50%;

  width: min(900px, 80%);
  height: 1px;

  transform: translateX(-50%);

  background: linear-gradient(
    90deg,
    transparent,
    rgba(103, 232, 249, 0.25),
    transparent
  );
}

.command-center-container {
  position: relative;
  z-index: 2;

  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.command-heading {
  margin-bottom: 45px;
}

/* COMMAND GRID */

.command-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;

  margin-bottom: 22px;
}

.command-card {
  position: relative;

  min-height: 145px;
  padding: 20px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;

  text-align: left;

  border: 1px solid rgba(148, 163, 184, 0.11);
  border-radius: 16px;

  color: #ffffff;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    );

  cursor: pointer;

  transition:
    border-color 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;
}

.command-card:hover {
  border-color: rgba(103, 232, 249, 0.28);

  background:
    linear-gradient(
      145deg,
      rgba(103, 232, 249, 0.07),
      rgba(255, 255, 255, 0.015)
    );
}

.command-card-active {
  border-color: rgba(103, 232, 249, 0.45);

  background:
    linear-gradient(
      145deg,
      rgba(103, 232, 249, 0.09),
      rgba(139, 92, 246, 0.035)
    );

  box-shadow:
    0 0 0 1px rgba(103, 232, 249, 0.04),
    0 18px 45px rgba(0, 0, 0, 0.2);
}

.command-card-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(103, 232, 249, 0.14);
  border-radius: 11px;

  color: #67e8f9;
  background: rgba(103, 232, 249, 0.05);

  font-size: 1.15rem;
}

.command-card-title {
  color: #e2e8f0;

  font-size: 0.79rem;
  font-weight: 750;
}

.command-card-arrow {
  position: absolute;
  right: 17px;
  bottom: 18px;

  color: #475569;

  font-size: 0.9rem;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.command-card:hover .command-card-arrow,
.command-card-active .command-card-arrow {
  color: #67e8f9;
  transform: translateX(3px);
}

/* DETAIL PANEL */

.command-detail-panel {
  position: relative;

  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 35px;

  padding: 30px;

  border: 1px solid rgba(103, 232, 249, 0.14);
  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      rgba(103, 232, 249, 0.045),
      rgba(139, 92, 246, 0.025)
    );

  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
}

.command-detail-left {
  display: flex;
  align-items: flex-start;
  gap: 18px;
}

.command-detail-icon {
  flex-shrink: 0;

  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(103, 232, 249, 0.2);
  border-radius: 13px;

  color: #67e8f9;
  background: rgba(103, 232, 249, 0.06);

  font-size: 1.35rem;
}

.command-detail-label {
  display: block;

  margin-bottom: 8px;

  color: #64748b;

  font-size: 0.59rem;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.command-detail-left h3 {
  margin-bottom: 10px;

  color: #f8fafc;

  font-size: 1.35rem;
  font-weight: 800;
}

.command-detail-left p {
  max-width: 560px;

  color: #94a3b8;

  font-size: 0.88rem;
  line-height: 1.75;
}

.command-detail-right {
  padding-left: 10px;
}

.command-points {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.command-point {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #cbd5e1;

  font-size: 0.82rem;
}

.command-point-dot {
  width: 6px;
  height: 6px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #67e8f9;

  box-shadow: 0 0 9px rgba(103, 232, 249, 0.7);
}

.command-quick-links {
  grid-column: 1 / -1;

  display: flex;
  gap: 10px;

  padding-top: 4px;

  border-top: 1px solid rgba(148, 163, 184, 0.08);
}

.command-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 9px 13px;

  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 9px;

  color: #94a3b8;
  background: rgba(255, 255, 255, 0.018);

  font-size: 0.74rem;
  font-weight: 700;

  transition:
    color 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.command-link:hover {
  transform: translateY(-2px);

  color: #67e8f9;

  border-color: rgba(103, 232, 249, 0.3);

  background: rgba(103, 232, 249, 0.04);
}

/* =========================================================
   SKILLS
========================================================= */

.skills-section {
  position: relative;

  padding: 110px 0;

  background: #060a18;
}

.skills-container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.skill-card {
  padding: 25px;

  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 16px;

  background: rgba(255, 255, 255, 0.018);

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.skill-card:hover {
  transform: translateY(-5px);

  border-color: rgba(103, 232, 249, 0.25);

  background: rgba(103, 232, 249, 0.025);
}

.skill-card h3 {
  margin-bottom: 14px;

  color: #f8fafc;
  font-size: 1rem;
}

.skill-card p {
  color: #94a3b8;
  font-size: 0.85rem;
  line-height: 1.7;
}

/* =========================================================
   PROJECTS
========================================================= */

.projects-section {
  position: relative;

  padding: 120px 0;

  background: #050816;
}

.projects-container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.project-card {
  position: relative;

  padding: 26px;

  border: 1px solid rgba(148, 163, 184, 0.11);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    );

  transition:
    border-color 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.project-card:hover,
.project-card-active {
  border-color: rgba(103, 232, 249, 0.28);

  background:
    linear-gradient(
      145deg,
      rgba(103, 232, 249, 0.045),
      rgba(255, 255, 255, 0.012)
    );

  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 22px;
}

.project-icon {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(103, 232, 249, 0.15);
  border-radius: 12px;

  color: #67e8f9;
  background: rgba(103, 232, 249, 0.05);
}

.project-number {
  color: #334155;

  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 0.78rem;
  font-weight: 800;
}

.project-category {
  display: block;
  margin-bottom: 9px;

  color: #67e8f9;

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.project-content h3 {
  margin-bottom: 12px;

  color: #f8fafc;
  font-size: 1.4rem;
}

.project-description {
  margin-bottom: 18px;

  color: #94a3b8;
  font-size: 0.86rem;
  line-height: 1.75;
}

.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;

  margin-bottom: 22px;
}

.project-tech span {
  padding: 6px 9px;

  border: 1px solid rgba(148, 163, 184, 0.11);
  border-radius: 7px;

  color: #94a3b8;
  background: rgba(255, 255, 255, 0.02);

  font-size: 0.65rem;
}

.project-details-btn {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 0;

  border-top: 1px solid rgba(148, 163, 184, 0.09);

  color: #cbd5e1;
  background: transparent;

  cursor: pointer;

  font-size: 0.78rem;
  font-weight: 700;

  transition: color 0.25s ease;
}

.project-details-btn:hover {
  color: #67e8f9;
}

.project-details-btn svg {
  transition: transform 0.25s ease;
}

.project-chevron-open {
  transform: rotate(180deg);
}

.project-details {
  overflow: hidden;
}

.project-detail-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 17px 0;
}

.project-detail-icon {
  width: 34px;
  height: 34px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  color: #67e8f9;
  background: rgba(103, 232, 249, 0.06);
}

.project-detail-item span {
  display: block;
  margin-bottom: 6px;

  color: #64748b;

  font-size: 0.59rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.project-detail-item p {
  color: #94a3b8;
  font-size: 0.8rem;
  line-height: 1.7;
}

.project-github-btn {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 11px 15px;

  border: 1px solid rgba(103, 232, 249, 0.18);
  border-radius: 9px;

  color: #cbd5e1;
  background: rgba(103, 232, 249, 0.035);

  font-size: 0.76rem;
  font-weight: 700;

  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    color 0.25s ease;
}

.project-github-btn:hover {
  color: #67e8f9;
  border-color: rgba(103, 232, 249, 0.4);
  background: rgba(103, 232, 249, 0.07);
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {
  .nav-links {
    gap: 17px;
  }

  .hero-container {
    gap: 40px;
  }

  .command-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .command-card {
    min-height: 135px;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 800px) {
  .nav-container {
    min-height: 68px;
  }

  .nav-links {
    display: none;
  }

  .hire-btn {
    min-width: 90px;
    padding: 9px 15px;
  }

  .hero-section {
    padding: 115px 0 70px;
  }

  .hero-container {
    grid-template-columns: 1fr;
    gap: 55px;

    text-align: center;
  }

  .hero-content {
    max-width: 100%;
  }

  .availability-badge {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-name {
    font-size: clamp(2.1rem, 10vw, 3rem);
  }

  .code-role {
    justify-content: center;
  }

  .hero-description {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-socials {
    justify-content: center;
  }

  .hero-stats {
    justify-content: center;
    gap: 24px;
  }

  .hero-visual {
    min-height: 490px;
  }

  .photo-card {
    width: 245px;
    height: 330px;
  }

  .degree-card {
    top: 45px;
    left: 2%;
  }

  .specialization-card {
    right: 2%;
    bottom: 105px;
  }

  .experience-card {
    left: 5%;
    bottom: 25px;
  }

  .mini-profile-card {
    right: 3%;
    top: 35px;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  .command-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .command-detail-panel {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .command-detail-right {
    padding-left: 0;
  }

  .command-quick-links {
    grid-column: auto;
  }

  .skills-grid {
    grid-template-columns: 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 520px) {
  .nav-container,
  .hero-container,
  .about-container,
  .command-center-container,
  .skills-container,
  .projects-container {
    width: min(100% - 28px, 1180px);
  }

  .hero-name {
    font-size: clamp(2rem, 11vw, 2.7rem);
  }

  .hero-description {
    font-size: 0.9rem;
  }

  .hero-stats {
    gap: 16px;
  }

  .hero-stat strong {
    font-size: 0.95rem;
  }

  .hero-stat span {
    font-size: 0.54rem;
  }

  .hero-visual {
    min-height: 455px;
  }

  .photo-card {
    width: 220px;
    height: 300px;
  }

  .floating-card {
    min-width: 125px;
    padding: 11px 12px;
  }

  .floating-card strong {
    font-size: 0.72rem;
  }

  .floating-card small {
    font-size: 0.61rem;
  }

  .degree-card {
    top: 40px;
    left: 0;
  }

  .specialization-card {
    right: 0;
    bottom: 100px;
  }

  .experience-card {
    left: 0;
    bottom: 20px;
  }

  .mini-profile-card {
    right: 0;
    top: 25px;
  }

  .command-center-section,
  .skills-section,
  .projects-section,
  .about-section {
    padding: 85px 0;
  }

  .command-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .command-card {
    min-height: 125px;
    padding: 15px;
  }

  .command-card-icon {
    width: 37px;
    height: 37px;
    font-size: 1rem;
  }

  .command-card-title {
    font-size: 0.68rem;
  }

  .command-detail-panel {
    padding: 20px;
  }

  .command-detail-left {
    gap: 13px;
  }

  .command-detail-icon {
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
  }

  .command-detail-left h3 {
    font-size: 1.1rem;
  }

  .command-detail-left p {
    font-size: 0.8rem;
  }

  .command-point {
    font-size: 0.75rem;
  }

  .command-quick-links {
    flex-wrap: wrap;
  }

  .project-card {
    padding: 20px;
  }
}

/* =========================================================
   EXTRA SMALL
========================================================= */

@media (max-width: 380px) {
  .hire-btn {
    min-width: auto;
    padding: 8px 12px;
  }

  .hero-buttons {
    flex-direction: column;
    width: 100%;
  }

  .hero-btn {
    width: 100%;
  }

  .hero-stats {
    gap: 12px;
  }

  .command-grid {
    grid-template-columns: 1fr;
  }

  .command-card {
    min-height: 100px;

    flex-direction: row;
    align-items: center;
    gap: 13px;
  }

  .command-card-arrow {
    top: 50%;
    right: 17px;
    bottom: auto;

    transform: translateY(-50%);
  }

  .command-card:hover .command-card-arrow,
  .command-card-active .command-card-arrow {
    transform: translate(3px, -50%);
  }
}